{"id": "HIST-001-R5", "version": 1, "type": "decision", "origin": "reconstructed", "status": "proposed", "tier": "candidate", "subject": "aec-scope", "text": "Use Spec Kit’s extension manifest and optional workflow hooks rather than a fork.", "source_sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "reconstruction": {"id": "HIST-001-R5", "text": "Use Spec Kit’s extension manifest and optional workflow hooks rather than a fork.", "source_path": "specs/001-ast-bedrock-extension/research.md", "source_section": "R5. Spec Kit extension mechanism (v1.2.3, verified in the installed package)", "source_quote": "each `optional: true`"}, "relations": [{"rel": "depends_on", "to": "HISTSRC-HIST-001-R5@1"}]}
