// AEC's own purpose and authority records (dogfood). The Spec Kit constitution references these by id@version.
{"id":"AU-zach","version":1,"type":"authority","text":"Zach Rhodes: design intent and acceptance for AEC","governs":["aec-purpose","aec-scope","aec-acceptance"]}
{"id":"AU-speckit","version":1,"type":"authority","text":"Pinned GitHub Spec Kit release (v1.2.3): workflow, artifacts, extension schema","governs":["sdd-workflow"]}
{"id":"AEC-P0","version":1,"type":"purpose","subject":"aec-purpose","epistemic":"committed","owner":"AU-zach","text":"Keep why something is built attached to what gets built in AI-assisted development, as a measurable extension to spec-driven development (Spec Kit), so conclusions that stop being justified are caught and legitimate revisions are kept distinct"}
{"id":"AEC-R1","version":1,"type":"requirement","subject":"aec-purpose","epistemic":"committed","text":"Never create a competing authority: Spec Kit owns workflow; AEC owns purpose, authority-by-subject, evidence status and criteria versions","relations":[{"rel":"serves","to":"AEC-P0@1"}]}
{"id":"AEC-R2","version":1,"type":"requirement","subject":"aec-purpose","epistemic":"committed","text":"Deterministic checks are labelled as structural; nothing claims purpose preservation from passing structural tests","relations":[{"rel":"serves","to":"AEC-P0@1"}]}
{"id":"AEC-R3","version":1,"type":"requirement","subject":"aec-purpose","epistemic":"committed","text":"Adoption is earned against a well-configured Spec Kit baseline with authoring cost counted; if equal, simplify AEC","relations":[{"rel":"serves","to":"AEC-P0@1"}]}
{"id":"AEC-R4","version":1,"type":"requirement","subject":"aec-scope","epistemic":"provisional","text":"Usable in a second real repo (Data-Guide overhaul) by installation, not copy-paste","relations":[{"rel":"serves","to":"AEC-P0@1"}]}
{"id":"AEC-R5","version":1,"type":"requirement","subject":"aec-purpose","epistemic":"committed","text":"Structural facts come from a deterministic edge graph of the code, regenerated on every change (Constitution VI; spec 001 US1)","relations":[{"rel":"serves","to":"AEC-P0@1"},{"rel":"implemented_by","to":"code:src.aec.edges.snapshot"},{"rel":"implemented_by","to":"code:src.aec.edges.diff"}]}
{"id":"AEC-R6","version":1,"type":"requirement","subject":"aec-purpose","epistemic":"committed","text":"A code change is traced to the conclusions that rely on it (spec 001 US2)","relations":[{"rel":"serves","to":"AEC-P0@1"},{"rel":"implemented_by","to":"code:src.aec.code_impact.code_impact"},{"rel":"implemented_by","to":"code:src.aec.impact.impact"}]}
{"id": "AEC-R7", "version": 1, "type": "requirement", "subject": "aec-scope", "epistemic": "committed", "text": "A repo adopts AEC by command: init scaffolds without overwriting; import-purpose turns Codex++ purpose files into provisional, provenance-linked records that never become authority (spec 002 US1-2)", "relations": [{"rel": "serves", "to": "AEC-R4@1"}, {"rel": "implemented_by", "to": "code:src.aec.init.init"}, {"rel": "implemented_by", "to": "code:src.aec.purpose_import.import_purpose"}]}
{"id": "AEC-R8", "version": 1, "type": "requirement", "subject": "aec-purpose", "epistemic": "committed", "text": "The checks tell 'it passes' from 'it works': a purpose-outcome claim resting only on contract-conformance evidence is warned about as an unsupported inference; evidence observed on changed code needs an applicability review, never invalidation (spec 002 US3-4)", "relations": [{"rel": "serves", "to": "AEC-P0@1"}, {"rel": "implemented_by", "to": "code:src.aec.records.check"}, {"rel": "implemented_by", "to": "code:src.aec.impact.impact"}]}
{"id": "HISTSRC-HIST-001-R1", "version": 1, "type": "source", "origin": "reconstructed", "status": "proposed", "text": "Repository artifact for HIST-001-R1", "ref": "specs/001-ast-bedrock-extension/research.md", "sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "section": "R1. Edge kinds and how \"refers to\" is resolved", "quote": "there are five kinds: `defines`, `calls`, `imports`, `inherits`, `references`"}
{"id": "HIST-001-R1", "version": 1, "type": "decision", "origin": "reconstructed", "status": "proposed", "tier": "candidate", "subject": "aec-scope", "text": "Use five static edge kinds and resolve references without full type inference.", "source_sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "reconstruction": {"id": "HIST-001-R1", "text": "Use five static edge kinds and resolve references without full type inference.", "source_path": "specs/001-ast-bedrock-extension/research.md", "source_section": "R1. Edge kinds and how \"refers to\" is resolved", "source_quote": "there are five kinds: `defines`, `calls`, `imports`, `inherits`, `references`"}, "relations": [{"rel": "depends_on", "to": "HISTSRC-HIST-001-R1@1"}]}
{"id": "HISTSRC-HIST-001-R2", "version": 1, "type": "source", "origin": "reconstructed", "status": "proposed", "text": "Repository artifact for HIST-001-R2", "ref": "specs/001-ast-bedrock-extension/research.md", "sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "section": "R2. Symbol identity", "quote": "a dotted module path derived from the file path relative to the analysis root"}
{"id": "HIST-001-R2", "version": 1, "type": "decision", "origin": "reconstructed", "status": "proposed", "tier": "candidate", "subject": "aec-scope", "text": "Identify symbols by root-relative dotted module and qualified definition names.", "source_sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "reconstruction": {"id": "HIST-001-R2", "text": "Identify symbols by root-relative dotted module and qualified definition names.", "source_path": "specs/001-ast-bedrock-extension/research.md", "source_section": "R2. Symbol identity", "source_quote": "a dotted module path derived from the file path relative to the analysis root"}, "relations": [{"rel": "depends_on", "to": "HISTSRC-HIST-001-R2@1"}]}
{"id": "HISTSRC-HIST-001-R3", "version": 1, "type": "source", "origin": "reconstructed", "status": "proposed", "text": "Repository artifact for HIST-001-R3", "ref": "specs/001-ast-bedrock-extension/research.md", "sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "section": "R3. Output format and determinism", "quote": "The diff compares identity (kind, src, dst)."}
{"id": "HIST-001-R3", "version": 1, "type": "decision", "origin": "reconstructed", "status": "proposed", "tier": "candidate", "subject": "aec-scope", "text": "Emit a header and stably sorted JSONL edges, with body hashes for definition changes.", "source_sha256": "1c78c7f2a33ce0a7561612a2c398802032a4a08f165fa8723218b0786a82ac7d", "reconstruction": {"id": "HIST-001-R3", "text": "Emit a header and stably sorted JSONL edges, with body hashes for definition changes.", "source_path": "specs/001-ast-bedrock-extension/research.md", "source_section": "R3. Output format and determinism", "source_quote": "The diff compares identity (kind, src, dst)."}, "relations": [{"rel": "depends_on", "to": "HISTSRC-HIST-001-R3@1"}]}
