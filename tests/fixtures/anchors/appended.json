{
  "note": "C-09 (spec 006). Source files are generated by the test in a temporary directory: valid.txt is the anchored original (45 bytes); grown.txt is valid.txt plus one appended line; edited.txt changes the first line and appends; short.txt is the first 20 bytes. Root 'ledger' points at the same directory as 'corpus' and declares grown.txt and edited.txt append-only in sources.json.",
  "append_only": {"ledger": ["edited.txt", "grown.txt"]},
  "cases": [
    {"id": "prefix-grown", "path": "grown.txt", "prefix_bytes": 45, "locator": "L2-3", "expected": "appended"},
    {"id": "prefix-unchanged-decoy", "path": "valid.txt", "prefix_bytes": 45, "locator": "L2-3", "expected": "verified"},
    {"id": "prefix-edited", "path": "edited.txt", "prefix_bytes": 45, "locator": "L2-3", "expected": "mismatch"},
    {"id": "prefix-truncated", "path": "short.txt", "prefix_bytes": 45, "locator": "L1", "expected": "mismatch"},
    {"id": "prefix-locator-in-appended-bytes", "path": "grown.txt", "prefix_bytes": 45, "locator": "q:appended line", "expected": "locator_invalid"},
    {"id": "whole-file-default-decoy", "path": "grown.txt", "locator": "L2-3", "expected": "mismatch"},
    {"id": "declared-append-only-grown", "root": "ledger", "path": "grown.txt", "locator": "L2-3", "expected": "appended"},
    {"id": "declared-append-only-edited", "root": "ledger", "path": "edited.txt", "locator": "L2-3", "expected": "mismatch"},
    {"id": "declared-append-only-unchanged-decoy", "root": "ledger", "path": "valid.txt", "locator": "L2-3", "expected": "verified"},
    {"id": "prefix-zero", "path": "valid.txt", "prefix_bytes": 0, "locator": "L1", "expected": "error"},
    {"id": "prefix-string", "path": "valid.txt", "prefix_bytes": "45", "locator": "L1", "expected": "error"},
    {"id": "prefix-bool", "path": "valid.txt", "prefix_bytes": true, "locator": "L1", "expected": "error"}
  ]
}
